function x_zero = metoda_siecznych_2(h,w)
% h - przedzial 
% w - tolerancja

x1 = h(1);
x1 = h(2);
tol = w;

% Zmienna do kontrolowania pętli (sztuczny błąd początkowy)
blad_przyblizenia = 100;

while blad_przyblizenia > tol
    f0 = badana_funkcja(a);
    f1 = badana_funkcja(b);
    
    if (f1 - f0) == 0
        disp('Błąd: f(x1) = f(x0), dzielenie przez zero.');
        break;
    end
    
    x2 = x1 - (f1 * (x1 - x0)) / (f1 - f0);

    blad_przyblizenia = abs(x2 - x1);
    
    x0 = x1;
    x1 = x2;
end

x_zero = x1;
disp("Znalezione miejsce zerowe:")
disp(x_zero);
disp("Wartość f(c):")
disp(badana_funkcja(x_zero));

end

function y = badana_funkcja(x)
    y = x^2 -x -2;
end
