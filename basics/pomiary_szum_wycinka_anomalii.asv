% Zadanie A

clc; clear; close all

time = 0:0.02:4*pi;
base_signal = 3 * sin(time);
noise =  -0.5 + (0.5 - (-0.5))*rand(1,size(time));
noisy_signal = base_signal + noise;

for n = 1:3
    index = rand()

tiledlayout(2,2)
title("porównanie zaszumionych sygnałow itd")

nexttile(1)
plot(time, base_signal, 'g-')
title("Sygnał bazowy")

nexttile(2)
plot(time, noisy_signal, 'r-')
title("Sygnal zaszumiony")